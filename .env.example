# CyberGuard Environment Variables

# Database
DATABASE_URL="postgresql://cyberguard:password@localhost:5432/cyberguard?schema=public"

# Redis (for job queue)
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_SECRET="change-this-to-a-random-secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# CORS
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# AI Provider (optional - uses deterministic templates if not configured)
AI_PROVIDER=template
AI_API_KEY=
AI_MODEL=gpt-4

# Port Scanning (disabled by default - requires explicit authorization)
PORT_SCAN_ENABLED=false
